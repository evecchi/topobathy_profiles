<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TopoBathyProfilesDialogBase</class>
 <widget class="QDialog" name="TopoBathyProfilesDialogBase">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1000</width>
    <height>750</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Topo-Bathy Profiles</string>
  </property>

  <layout class="QVBoxLayout" name="verticalLayout">

   <!-- ================= INPUT GROUP ================= -->
   <item>
    <widget class="QGroupBox" name="groupInput">
     <property name="title">
      <string>Input</string>
     </property>

     <layout class="QVBoxLayout">

      <!-- Section Layer -->
      <item>
       <layout class="QHBoxLayout">
        <item>
         <widget class="QLabel">
          <property name="text">
           <string>Section layer:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QgsMapLayerComboBox" name="comboSectionLayer"/>
        </item>
       </layout>
      </item>

      <!-- Section Field -->
      <item>
       <layout class="QHBoxLayout">
        <item>
         <widget class="QLabel">
          <property name="text">
           <string>Section field:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="comboSectionIdField"/>
        </item>
       </layout>
      </item>

      <!-- Section Feature -->
      <item>
       <layout class="QHBoxLayout">
        <item>
         <widget class="QLabel">
          <property name="text">
           <string>Section feature for profile:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="comboSectionFeature"/>
        </item>
       </layout>
      </item>

      <!-- Point Layer -->
      <item>
       <layout class="QHBoxLayout">
        <item>
         <widget class="QLabel">
          <property name="text">
           <string>Point layer:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="comboPunti"/>
        </item>
        <item>
         <widget class="QPushButton" name="btnAddLayer">
          <property name="text">
           <string>Add Layer</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btnRemoveLayer">
          <property name="text">
           <string>Remove Layer</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>

      <!-- Table -->
      <item>
       <widget class="QTableWidget" name="tableLayerAnno">
        <property name="columnCount">
         <number>4</number>
        </property>
        <column>
         <property name="text">
          <string>Layer</string>
         </property>
        </column>
        <column>
         <property name="text">
          <string>Label</string>
         </property>
        </column>
        <column>
         <property name="text">
          <string>Color</string>
         </property>
        </column>
        <column>
         <property name="text">
          <string>Elevation Field</string>
         </property>
        </column>
       </widget>
      </item>

      <!-- Buffer -->
      <item>
       <widget class="QPushButton" name="btnSetBuffer">
        <property name="text">
         <string>Set Buffer Distance</string>
        </property>
       </widget>
      </item>

      <!-- Filter Points -->
      <item>
       <layout class="QHBoxLayout">
        <item>
         <widget class="QCheckBox" name="chkFilterPoints">
          <property name="text">
           <string>Filter closer points</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QDoubleSpinBox" name="spinFilterDistance">
          <property name="minimum">
           <double>0.1</double>
          </property>
          <property name="maximum">
           <double>1000000.0</double>
          </property>
          <property name="value">
           <double>5.0</double>
          </property>
          <property name="enabled">
           <bool>false</bool>
          </property>
         </widget>
        </item>
       </layout>
      </item>

      <!-- Split Profile on Max Distance -->
      <item>
       <layout class="QHBoxLayout">
        <item>
         <widget class="QCheckBox" name="chkSplitProfile">
          <property name="text">
           <string>Split profile line for maximum distance</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QDoubleSpinBox" name="spinMaxSegmentLength">
          <property name="minimum">
           <double>0.1</double>
          </property>
          <property name="maximum">
           <double>1000000.0</double>
          </property>
          <property name="value">
           <double>20.0</double>
          </property>
          <property name="enabled">
           <bool>false</bool>
          </property>
         </widget>
        </item>
       </layout>
      </item>


      <!-- Run -->
      <item>
       <widget class="QPushButton" name="btnRun">
        <property name="text">
         <string>Run Analysis</string>
        </property>
       </widget>
      </item>

     </layout>
    </widget>
   </item>

   <!-- ================= PREVIEW GROUP ================= -->
   <item>
    <widget class="QGroupBox" name="groupPreview">
     <property name="title">
      <string>Preview</string>
     </property>

     <layout class="QVBoxLayout" name="layoutPreview">

      <item>
       <widget class="QComboBox" name="comboPreview"/>
      </item>

      <!-- Axis Controls -->
      <item>
       <layout class="QHBoxLayout">

        <item><widget class="QLabel"><property name="text"><string>X min</string></property></widget></item>
        <item><widget class="QDoubleSpinBox" name="spinXMin"/></item>

        <item><widget class="QLabel"><property name="text"><string>X max</string></property></widget></item>
        <item><widget class="QDoubleSpinBox" name="spinXMax"/></item>

        <item><widget class="QLabel"><property name="text"><string>Y min</string></property></widget></item>
        <item><widget class="QDoubleSpinBox" name="spinYMin"/></item>

        <item><widget class="QLabel"><property name="text"><string>Y max</string></property></widget></item>
        <item><widget class="QDoubleSpinBox" name="spinYMax"/></item>

       </layout>
      </item>

      <!-- Export Buttons -->
      <item>
       <layout class="QHBoxLayout">
        <item>
         <widget class="QPushButton" name="btnPreview">
          <property name="text">
           <string>Update Preview</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btnSaveGraph">
          <property name="text">
           <string>Export PNG</string>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout">
          <item>
           <widget class="QCheckBox" name="chkExportShownOnly">
            <property name="text">
             <string>Export only points visible in plot</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QPushButton" name="btnSaveCSV">
          <property name="text">
           <string>Export CSV</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>

     </layout>
    </widget>
   </item>

  </layout>
 </widget>

 <customwidgets>
  <customwidget>
   <class>QgsMapLayerComboBox</class>
   <extends>QWidget</extends>
   <header>qgis.gui</header>
  </customwidget>
 </customwidgets>

 <resources/>
 <connections/>
